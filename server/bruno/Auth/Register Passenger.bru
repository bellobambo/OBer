meta {
  name: Register Passenger
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "PASSENGER",
    "fullName": "John Doe",
    "phone": "08012345678",
    "email": "passenger@example.com",
    "password": "password123"
  }
}

script:post-response {
  const phone = res.body?.data?.user?.phone;
  const verificationCode = res.body?.data?.verificationCode;

  if (phone) {
    bru.setEnvVar("REGISTERED_PHONE", phone);
  }

  if (verificationCode) {
    bru.setEnvVar("VERIFICATION_CODE", verificationCode);
  }
}
