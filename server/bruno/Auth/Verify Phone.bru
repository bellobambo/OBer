meta {
  name: Verify Phone
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/register/verify-phone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{REGISTERED_PHONE}}",
    "code": "{{VERIFICATION_CODE}}"
  }
}

script:post-response {
  const token = res.body?.token || res.body?.data?.token;

  if (token) {
    bru.setEnvVar("AUTH_TOKEN", token);
  }
}
