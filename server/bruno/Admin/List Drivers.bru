meta {
  name: List Drivers
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/drivers?page=1&per_page=10&search={{ADMIN_DRIVER_SEARCH}}
  body: none
  auth: bearer
}

params:query {
  page: 1
  per_page: 10
  search: {{ADMIN_DRIVER_SEARCH}}
  ~status: ACTIVE
  ~sort: newest
}

auth:bearer {
  token: {{AUTH_TOKEN}}
}


