meta {
  name: Arm Hotspot
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/hotspot/arm
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{AUTH_TOKEN}}
}

body:json {
  {
    "placeName": "SUB",
    "coordinates": [4.524, 7.521]
  }
}

script:post-response {
  const hotspotId =
    res.body?.data?.hotspotId ||
    res.body?.data?.hotspot?.id;

  if (hotspotId) {
    bru.setEnvVar("HOTSPOT_ID", String(hotspotId));
  }
}
