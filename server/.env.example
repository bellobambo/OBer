PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/ober

# Secret used to sign bearer tokens
AUTH_TOKEN_SECRET=replace-this-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800

# Comma-separated emails allowed to call /api/admin/* endpoints
ADMIN_EMAILS=transport.admin@example.com,ops@example.com
